{
  "name": "homerun-orders",
  "version": "1.0.0",
  "private": true,
  "description": "Publix cart builder for HomeRun. Drives a dedicated logged-in Chrome over CDP.",
  "type": "commonjs",
  "scripts": {
    "status": "node cart.js status",
    "chrome:start": "launchctl kickstart -k gui/$(id -u)/com.homerun.chrome",
    "chrome:stop": "launchctl bootout gui/$(id -u)/com.homerun.chrome",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  }
}
