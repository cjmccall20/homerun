# HomeRun local config. bin/setup.mjs writes .env.local for you; this file
# just documents the keys.
HOMERUN_PIN=
HOMERUN_SECRET=
HOMERUN_VAULT=
# Path to the claude CLI if it is not on PATH:
CLAUDE_BIN=
# Optional: model for Claude jobs (default sonnet)
HOMERUN_CLAUDE_MODEL=
# Optional: Resend key for the morning goals email (bin/morning-email.mjs)
RESEND_API_KEY=
MORNING_EMAIL_TO=
MORNING_EMAIL_FROM=
# Optional: budget module (see SETUP.md)
HOMERUN_BUDGET_SNAPSHOT=
HOMERUN_BUDGET_DATA=
