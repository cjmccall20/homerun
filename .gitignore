# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# HomeRun
/jobs
.DS_Store

# launchd output
/homerun.log
/homerun.err

# uploaded recipe photos and the browser queue are runtime state
/jobs/

# self-update loop logs
/feedback-runner.log
/feedback-runner.out
/feedback-runner.err

# runtime
/jobs/
*.log
*.err
*.out
tsconfig.tsbuildinfo
# generated by bin/setup.mjs (machine-specific absolute paths)
/.claude/settings.json
/.claude/dev-settings.json
/prompts/feedback.md
morning-email.err
# orders sidecar runtime (generated sandbox, logged-in browser profile, logs)
/orders-sidecar/.claude/settings.json
/orders-sidecar/chrome-profile/
/orders-sidecar/node_modules/
/orders-sidecar/*.log
/orders-sidecar/*.err
